# Comma-separated frontend origins. Wildcards are not allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:5500
# Production example: ALLOWED_ORIGINS=https://your-frontend-domain.example
# Optional future AI service URL, for example https://smartcattle-ai.example.com
SMARTCATTLE_AI_URL=
# Shared key for the endpoints the AI service calls: POST /api/ai/events,
# PUT /api/ai/cameras/{id}/status and PUT /api/animals/{tag}/detection.
# Empty leaves those endpoints open; set it in production.
#
# NEVER put this in the frontend. VITE_ variables are public in the browser
# bundle, which is why browser-facing endpoints use a user token instead.
AI_API_KEY=
# Key for the farm assistant's language model. Empty = POST /api/assistant/messages answers 503
# and the dashboard answers with its own rules. Never put it in a VITE_ variable.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# PostgreSQL connection. Empty = in-memory storage (data lost on restart).
# Local example: DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/smartcattle
# Then create the tables with: alembic upgrade head
DATABASE_URL=
# Seconds without an AI status report before a camera is shown as offline (10-3600).
CAMERA_OFFLINE_AFTER_SECONDS=60

# --- Authentication ---
# Signs the access tokens. REQUIRED for authentication to work: while it is
# empty, /api/auth/* answers 503 and no endpoint is protected.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs every existing token out.
JWT_SECRET=
# Access token lifetime in minutes (5-1440). There is no refresh token, so this
# is how long a session lasts.
ACCESS_TOKEN_MINUTES=60
# Failed logins per address before it is refused for LOGIN_LOCKOUT_SECONDS.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Video uploads ---
# Alerts outside the dashboard. Each channel stays off until it has credentials, and each account chooses its
# recipient in Settings. WhatsApp needs a template approved by Meta, with three body parameters: text, camera, time.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=smartcattle_alert
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
# Or WhatsApp through an OpenClaw gateway, without Meta's approval: both, and not together with the Cloud API above.
# The token gives full control of the gateway, so keep it on this machine or a private network.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# From @BotFather. Free and needs no approval.
TELEGRAM_BOT_TOKEN=
# A herd walking out is one message per camera and type within this many minutes.
NOTIFICATION_COOLDOWN_MINUTES=15

# S3-compatible bucket for uploaded videos: Cloudflare R2 in production,
# moto locally (docker-compose). Set all four or none; empty means the upload endpoints and
# the AI video-job endpoints answer 503. Browsers upload straight to the
# bucket, so its CORS rules must allow PUT from ALLOWED_ORIGINS.
# R2 example: VIDEO_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
VIDEO_STORAGE_ENDPOINT=
VIDEO_STORAGE_BUCKET=
VIDEO_STORAGE_ACCESS_KEY_ID=
VIDEO_STORAGE_SECRET_ACCESS_KEY=
# R2 ignores the region; "auto" is what it documents.
VIDEO_STORAGE_REGION=auto
# Host that browsers and the AI service use, when it differs from the one the
# API uses (docker-compose: http://localhost:9000). Empty = same.
VIDEO_STORAGE_PUBLIC_ENDPOINT=
# Minutes a presigned upload URL stays valid (5-720).
VIDEO_UPLOAD_URL_MINUTES=120

# --- RTSP camera service (camara/api.py) ---
# The browser never sees this key: /api/camera-streams adds it on the way to the service. Set both or neither; empty
# means those endpoints answer 503. The service only listens on its own PC, so this backend must run on that PC too.
# Use the same value as CAMERA_API_KEY in the service's own .env.
# With PUBLIC_REGISTRATION=true, anyone who signs up can point that PC's FFmpeg at an address: keep it false if the
# backend can be reached from outside.
CAMERA_MANAGER_URL=
CAMERA_API_KEY=

# On the internet (render.yaml sets these). Limits per address: RATE_LIMIT_ENABLED stays on unless set to false.
RATE_LIMIT_ENABLED=true
# Only behind a proxy that sets the client's address.
TRUST_PROXY_HEADERS=false
# false: after the first account, only the owner creates accounts.
# Each registered person gets a space of their own. false: every account shares one farm.
ACCOUNT_ISOLATION=true
PUBLIC_REGISTRATION=true
# true: the herd, events and cameras need a session too.
REQUIRE_AUTH_FOR_READS=false
API_DOCS_ENABLED=true

# Imou developer account (https://open.imoulife.com): its cameras open through Imou's cloud by serial number, so they
# can be watched from anywhere. The Cameras page recommends them. Both or neither; never commit the secret.
IMOU_APP_ID=
IMOU_APP_SECRET=
# The account's data center; the default is the international one.
IMOU_API_URL=https://openapi.easy4ip.com/openapi

# Keeps a sleeping host awake: the API asks for its own /api/health every KEEP_ALIVE_MINUTES. It needs the
# service's public address. Render provides RENDER_EXTERNAL_URL by itself, so there is nothing to set there;
# on another host set KEEP_ALIVE_URL=https://your-api.example.com. With neither, nothing runs (local development).
# It cannot wake a process that already stopped: for that, add a monitor outside the host (docs/DEPLOYMENT.md).
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=
RENDER_EXTERNAL_URL=
KEEP_ALIVE_MINUTES=12

# The cover page's video ("Video Inicio"), apart from the analysed recordings and the live cameras.
# VIDEO_INICIO_URL is the default: https://... or a file published with the frontend, such as /video-inicio.mp4.
# Empty means the cover shows its own 3D scene. An administrator can replace it from Settings.
VIDEO_INICIO_URL=
# Comma-separated emails of the owners who may change the cover video. Empty: nobody where PUBLIC_REGISTRATION
# is true (anyone can become an owner there), every owner where it is false.
SITE_ADMIN_EMAILS=
